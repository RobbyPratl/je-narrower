modules = ["nodejs-20"]

run = ["node", "engine/node_modules/tsx/dist/cli.mjs", "engine/src/cli.ts", "serve-replit"]

[packager.features]
enabledForHosting = false

[deployment]
build = "npm exec --yes --package=pnpm@9.15.9 -- pnpm install --frozen-lockfile --network-concurrency=1 --child-concurrency=1 && npm exec --yes --package=pnpm@9.15.9 -- pnpm build"
run = ["node", "engine/node_modules/tsx/dist/cli.mjs", "engine/src/cli.ts", "serve-replit"]
deploymentTarget = "cloudrun"
